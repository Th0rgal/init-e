/-- `htab_set(t, key, value); return 0` on a ready table. -/
theorem jsSet_aqgdU (Tk Kk V Hl Hc Nj1 : BitVec 64) (l : TLay) (S : Set (BitVec 64)) (Mx : Mem) (Gx : GA)
    (hwP : w.toNat < P0.toNat) (hwT : ¬ TabPhys Tk l w) (rv : TabRV D B Tk l Hl S Mx) (hH : HeapIs Gx Hc)
    (hn : Gx.lookup (ofString "journal_n") = some (.val (.word Nj1))) (hHl : Hl.toNat ≤ Hc.toNat)
    (Dall : ∀ a : BitVec 64, a.toNat < 33806089496 → D a)
    (sup : l.KL = 20 ∨ l.KL = 32 ∨ l.KL = 52) (sd : l.SD.toNat ≤ 56) (hV : V ∈ S)
    (hKE : Kk.toNat + 52 ≤ 33806089496) :
    AQGD D B (JWSBUS SP0 P0 FM G0 J C SKB Bo U Sc) w (fun _ => False)
      (fun L M G => JL Tk Kk V L ∧ M = Mx ∧ G = Gx) (fun _ _ _ => False)
      (fun _ M' G' => (∃ Hp : BitVec 64, HeapIs G' Hp ∧ Hc.toNat ≤ Hp.toNat ∧
        G'.lookup (ofString "journal_n") = some (.val (.word Nj1)) ∧
        ∀ x, ¬ TabPhys Tk l x → x.toNat < Hc.toNat → M' x = Mx x) ∧ SetRV D B Tk l Hc S M' G') jsSet := by
  unfold jsSet
  refine aqgd_seq (aqgd_call_htabSet_rv2U (LP := JL Tk Kk V) _ _ _ Tk Kk V Hl Hc Nj1 l S Mx Gx hwP hwT rv hH hn hHl
    Dall sup sd hV hKE (fun s _ _ _ lp => by
      rw [evalListHOLFinite_eq_toExact]
      simp [evalListHOLExact,evalHOLExact,lp.1,lp.2.1,lp.2.2]))
    (aqgd_return _ (fun s v G _ hG ⟨⟨_,post⟩,srv⟩ _ _ => by unfold GIs at hG; subst hG; exact ⟨post,srv⟩))

#print axioms jsSet_aqgdU

/-- The journal record and the final set, from the state after the key copy. -/
theorem jsRec_aqgdU (Tk Kk V Nj H0 Hl : BitVec 64) (l : TLay) (S : Set (BitVec 64)) (M0 : Mem)
    (rv : TabRV D B Tk l Hl S M0) (hHl : Hl.toNat ≤ H0.toNat)
    (below : ∀ x, TabPhys Tk l x → x.toNat < H0.toNat) (jsep : ∀ x, InJ J C x → ¬ TabPhys Tk l x)
    (jfit : J.toNat + C.toNat * 32 ≤ 33806089496) (hwJ : ¬ InJ J C w)
    (hwP : w.toNat < P0.toNat) (hwT : ¬ TabPhys Tk l w)
    (Dall : ∀ a : BitVec 64, a.toNat < 33806089496 → D a)
    (sup : l.KL = 20 ∨ l.KL = 32 ∨ l.KL = 52) (sd : l.SD.toNat ≤ 56) (hV : V ∈ S)
    (hKE : Kk.toNat + 52 ≤ 33806089496) :
    AQGD D B (JWSBUS SP0 P0 FM G0 J C SKB Bo U Sc) w (fun _ => False)
      (fun L M G => JSt Tk Kk V J C Nj H0 M0 L M G ∧
        L.lookup (ofString "r") = some (.val (.word (J + Nj * 32#64))))
      (fun _ _ _ => False) (fun _ M' G' => JSRV D B Tk l S J C Nj H0 M0 M' G') jsRec := by
  unfold jsRec
  have jst : ∀ (d v : ExpHOL 64) (o : BitVec 64), o.toNat < 32 →
      (∀ {F : Type} (s : PanSemStateFiniteExact 64 F),
        s.locals.lookup (ofString "r") = some (.val (.word (J + Nj * 32#64))) →
        EV s d = some (.val (.word (J + Nj * 32#64 + o)))) →
      (∀ {F : Type} (s : PanSemStateFiniteExact 64 F) x, JSt Tk Kk V J C Nj H0 M0 s.locals s.memory s.globals →
        EV s v = some x → ∃ y : BitVec 64, x = .val (.word y)) →
      AQGD D B (JWSBUS SP0 P0 FM G0 J C SKB Bo U Sc) w (fun _ => False)
        (fun L M G => JSt Tk Kk V J C Nj H0 M0 L M G ∧
          L.lookup (ofString "r") = some (.val (.word (J + Nj * 32#64))))
        (fun L M G => JSt Tk Kk V J C Nj H0 M0 L M G ∧
          L.lookup (ofString "r") = some (.val (.word (J + Nj * 32#64))))
        (fun _ M' G' => JSRV D B Tk l S J C Nj H0 M0 M' G')
        (.store d v) := by
    intro d v o ho hd hv
    refine aqgd_store _ _ (fun s G _ hG ⟨st,hr⟩ _ => ?_) (fun s x G _ hG ⟨st,_⟩ _ ev => ?_)
    · unfold GIs at hG; subst hG
      obtain ⟨hjl,hold,hkc,fr,hn,hlt,hH⟩ := st
      obtain ⟨inj,_⟩ := inj_entry (o := o) hlt jfit ho
      refine ⟨_,hd s hr,fun e => hwJ (e ▸ inj),fun y _ => ⟨⟨hjl,hold,hkc,fun x hx hnj => ?_,hn,hlt,hH⟩,hr⟩⟩
      have : x ≠ J + Nj * 32#64 + o := fun e => hnj (e ▸ inj)
      simp only [if_neg this]
      exact fr x hx hnj
    · unfold GIs at hG; subst hG
      exact hv s x st ev
  refine aqgd_seq (jst _ _ 0#64 (by decide) (fun s hr => by simp [EV,evalHOLExact,hr])
    (fun s x ⟨⟨ht,_⟩,_⟩ ev => by simp [EV,evalHOLExact,ht] at ev; exact ⟨_,ev.symm⟩)) ?_
  refine aqgd_seq (jst _ _ 8#64 (by decide)
    (fun s hr => by simp [EV,evalHOLExact,evalListHOLExact,hr,wordOpHOL,wordOp,valueIsWord,valueWord])
    (fun s x ⟨_,_,⟨q,hq⟩,_⟩ ev => by simp [EV,evalHOLExact,hq] at ev; exact ⟨_,ev.symm⟩)) ?_
  refine aqgd_seq (jst _ _ 16#64 (by decide)
    (fun s hr => by simp [EV,evalHOLExact,evalListHOLExact,hr,wordOpHOL,wordOp,valueIsWord,valueWord])
    (fun s x ⟨_,⟨a,b,ho⟩,_⟩ ev => by simp [EV,evalHOLExact,ho] at ev; exact ⟨_,ev.symm⟩)) ?_
  refine aqgd_seq (jst _ _ 24#64 (by decide)
    (fun s hr => by simp [EV,evalHOLExact,evalListHOLExact,hr,wordOpHOL,wordOp,valueIsWord,valueWord])
    (fun s x ⟨_,⟨a,b,ho⟩,_⟩ ev => by simp [EV,evalHOLExact,ho] at ev; exact ⟨_,ev.symm⟩)) ?_
  -- journal_n = journal_n + 1
  refine aqgd_seq (Q := fun L M G => JL Tk Kk V L ∧ ((∀ x, x.toNat < H0.toNat → ¬ InJ J C x → M x = M0 x) ∧
      G.lookup (ofString "journal_n") = some (.val (.word (Nj + 1))) ∧ Nj.toNat < C.toNat ∧
      ∃ H2 : BitVec 64, HeapIs G H2 ∧ H0.toNat ≤ H2.toNat))
    (aqgd_assignGlobal _ _ (fun s v aw ⟨⟨hjl,_,_,fr,hn,hlt,H2,hH2,hle⟩,_⟩ _ ev => ?_)) ?_
  · simp [EV,evalHOLExact,evalListHOLExact,hn,wordOpHOL,wordOp,valueIsWord,valueWord] at ev
    subst ev
    refine ⟨jwsbus_update_n aw _,hjl,fr,by simp [setGlobalHOLFinite,HolFiniteMapExact.lookup_update,FUPDATE],hlt,
      H2,?_,hle⟩
    have ne : ofString "journal_n" ≠ ofString "heap_ptr" := by decide
    unfold HeapIs at hH2 ⊢
    simp [setGlobalHOLFinite,HolFiniteMapExact.lookup_update,FUPDATE,ne,hH2]
  -- the final set on the table, ready at the current memory
  refine aqgd_ghostJ (fun M1 G1 ⟨fr,hn1,hlt,H2,hH2,hle⟩ => ?_)
  have rv1 : TabRV D B Tk l Hl S M1 := tabRV_frame rv (fun x hx => fr x (below x hx) (fun hj => jsep x hj hx))
  exact aqgd_conseq (jsSet_aqgdU Tk Kk V Hl H2 (Nj + 1) l S M1 G1 hwP hwT rv1 hH2 hn1 (by omega) Dall sup sd hV hKE)
    (fun _ _ _ h => h) (fun _ _ _ h => h)
    (fun _ M' G' ⟨⟨Hp,hHp,le,hn',fr'⟩,srv⟩ => ⟨hlt,hn',⟨H2,hle,srv⟩,fun x hx hnj hnt =>
      (fr' x hnt (by omega)).trans (fr x hx hnj)⟩)

