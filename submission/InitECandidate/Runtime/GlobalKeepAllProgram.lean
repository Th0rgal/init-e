def goodGA (function : MlS) : Bool := goodGAList.contains function

theorem program_check_ga : (functionsHOL sourceDeclarations).all
    (fun entry => !(goodGA entry.1) || keepsGA goodGA entry.2.2.1) = true := by
  decide_cbv

theorem goodGA_bodies : ∀ function, goodGA function = true → ∀ values body callee rs,
    lookupCodeHOLFinite originalRuntimeCode.lookup function values = some (body,callee,rs) →
    keepsGA goodGA body = true := by
  intro f hf values body callee rs h
  obtain ⟨params,rs',hc⟩ := lookupCode_installed h
  have := List.all_eq_true.mp program_check_ga _ (originalRuntimeCode_mem hc)
  simpa [hf] using this

theorem keepsGA_of_installed {f : MlS} {params : List (MlS × ShapeHOL)} {body : ProgHOL 64} {rs : ShapeHOL}
    (h : originalRuntimeCode.lookup f = some (params,body,rs)) (hf : goodGA f = true) :
    keepsGA goodGA body = true := by
  have := List.all_eq_true.mp program_check_ga _ (originalRuntimeCode_mem h)
  simpa [hf] using this

/-- An installed original function in both good sets keeps memory and all globals. -/
theorem memoryFrame_of_good {f : MlS} {params : List (MlS × ShapeHOL)} {body : ProgHOL 64} {rs : ShapeHOL}
    (h : originalRuntimeCode.lookup f = some (params,body,rs)) (hm : goodMem f = true) (hg : goodGA f = true) :
    MemoryFrame body := fun state code =>
  ⟨evaluate_keeps_mem body (keepsMem_of_installed h hm) state code,
    evaluate_keepsGA goodGA goodGA_bodies body (keepsGA_of_installed h hg) state code⟩

#print axioms program_check_ga
#print axioms memoryFrame_of_good
end InitECandidate.Runtime
