/-- Whole-table WordSimp endpoint: for every pinned function body, from every
gc-safe state with a non-error run, `compileExp` runs identically and its work
at the exact selector price is at most the source's at that price plus 24 per
site-tabled constant re-assignment. -/
theorem wordSimp_table_run_cost {C F : Type} :
    ∀ x ∈ InitECandidate.Proofs.FrontendStages.Word.outputs, ∀ (s : WordSemStateFiniteExact 64 C F),
      WordSimp.gcFunConstOk s.gcFun → (evaluate x.2.2 s).1 ≠ some .error →
      evaluate (WordSimp.compileExp x.2.2) s = evaluate x.2.2 s ∧
        wordExecutionCost (preIselPrice riscvConfig) (WordSimp.compileExp x.2.2) s ≤
          wordExecutionCost (bP riscvConfig (fun q => surOf wsT2 q + surOf wsT1 q)) x.2.2 s := by
  intro x hx s g ok
  obtain ⟨hc, hd⟩ := ws_all_ok x hx
  have hcf := cfOkB_sound riscvConfig wsT1 _ _ hc
  have hsd := hd
  rw [constFpF_eq] at hsd
  exact compileExp_run_cost riscvConfig (surShape_surOf wsT1) (surShape_surOf wsT2) x.2.2 hcf hsd s g ok

#print axioms ws_all_ok
#print axioms wordSimp_table_run_cost
