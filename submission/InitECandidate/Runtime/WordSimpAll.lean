/-! WordSimp's `compileExp` over the whole pinned function table: each source
body (`FrontendStages.Word.outputs`, the Loop→Word output) has kernel-checked
`cfOkB`/`sdiOkB` certificates against the site tables `wsT1`/`wsT2`, so
`compileExp_run_cost` applies with node surcharge `surOf wsT2 + surOf wsT1`. -/

/-- The certificate obligations for one pinned body. -/
def WsOk (x : Nat × Nat × WordLangProgHOL (BitVec 64)) : Prop :=
  cfOkB riscvConfig wsT1 (WordSimp.seqAssoc .skip x.2.2) .ln = true ∧
    SdiOk riscvConfig (surOf wsT2) (constFpF (WordSimp.seqAssoc .skip x.2.2))

theorem ws_conv (x : Nat × Nat × WordLangProgHOL (BitVec 64))
    (h : cfOkB riscvConfig wsT1 (WordSimp.seqAssoc .skip x.2.2) .ln = true ∧
      sdiOkB riscvConfig wsT2 (constFpF (WordSimp.seqAssoc .skip x.2.2)) = true) :
    WsOk x :=
  ⟨h.1, sdiOkB_sound riscvConfig wsT2 _ h.2⟩

theorem ws_conv25 (x : Nat × Nat × WordLangProgHOL (BitVec 64))
    (h : cfOkB riscvConfig wsT1 (WordSimp.seqAssoc .skip x.2.2) .ln = true ∧
      (sdiOkB riscvConfig wsT2 (constFpF (WordSimp.seqAssoc .skip x.2.2)) = true ∨
        peelB riscvConfig wsT2 3577 (constFpF (WordSimp.seqAssoc .skip x.2.2)) = true)) :
    WsOk x := by
  refine ⟨h.1, ?_⟩
  rcases h.2 with hs | hp
  · exact sdiOkB_sound riscvConfig wsT2 _ hs
  · exact peelB_sound riscvConfig wsT2 3577 _ hp

