import InitECandidate.Runtime.HeaderFinalFrameReach
import InitECandidate.Runtime.HeaderCarryEnv
import InitECandidate.Runtime.HeaderBytesStepContentFrame
import InitECandidate.Runtime.HeaderWordFieldStepContentFrame
import InitECandidate.Runtime.HeaderRlpFieldAssignmentReach
import InitECandidate.Runtime.HeaderExpressionStoreFrame
import InitECandidate.Runtime.RecordOffsetAboveCeiling
/-!
The actual current/legacy suffix keeps the decoder carry.

`decodeHeaderAt 56` selects the current or the legacy suffix and then returns the
header pointer.  The legacy suffix stores the constant zero at record offsets 232 and
240; the current suffix parses field 21 into offset 232, calls the numeric parser for
field 22 into local `bg` and stores field 22's word at record offset 240.  None of those
writes touches offset 32, so the state root word generated by the early bytes chain is
still at `record + 32` when the body returns the pointer at `decodeHeaderAt 57`.

Every step is used with its ceiling-based content frame, so nothing below the ceiling is
assumed untouched, and the readable table and the `arr`/`h` locals are re-established
against the carry's reference state exactly as in the field phases.
-/
namespace InitECandidate.Runtime
open Flapjack Flapjack.Pancake.PanLang Flapjack.PanSemStateFiniteExact
open Flapjack.Basis.Pure.MlString
set_option maxRecDepth 100000
set_option maxHeartbeats 800000

/-- The state root at record offset 32 is never the destination of a record store at
another offset of the record. -/
theorem record_offset_toNat (offset : Nat) (bound : offset < 2^64) :
    (BitVec.ofNat 64 offset).toNat = offset := by
  rw [BitVec.toNat_ofNat]
  exact Nat.mod_eq_of_lt bound

theorem record_sum_toNat (record : BitVec 64) (offset : Nat)
    (recordFits : record.toNat + 248 < 2^64) (bound : offset < 248) :
    (record + BitVec.ofNat 64 offset).toNat = record.toNat + offset := by
  rw [BitVec.toNat_add,record_offset_toNat offset (by omega)]
  exact Nat.mod_eq_of_lt (by have h := recordFits; omega)

theorem record_root_apart (record : BitVec 64) (offset : Nat)
    (recordFits : record.toNat + 248 < 2^64) (bound : offset < 248) (different : offset ≠ 32) :
    record + 32#64 ≠ record + BitVec.ofNat 64 offset := by
  intro same
  have both := congrArg BitVec.toNat same
  rw [record_sum_toNat record 32 recordFits (by decide),
    record_sum_toNat record offset recordFits bound] at both
  exact different (by omega)

/-- A word below the record is never one of the record's own destinations. -/
theorem record_below_apart (record : BitVec 64) (offset : Nat) (address : BitVec 64)
    (recordFits : record.toNat + 248 < 2^64) (bound : offset < 248)
    (low : address.toNat < record.toNat) : address ≠ record + BitVec.ofNat 64 offset := by
  intro same
  have both := congrArg BitVec.toNat same
  rw [record_sum_toNat record offset recordFits bound] at both
  omega

/-- Rewrite a run by an equal evaluation of its program. -/
theorem header_reaches_same_evaluation {F : Type} (s : PanSemStateFiniteExact 64 F)
    (program normalized tail : ProgHOL 64) (P : PanSemStateFiniteExact 64 F → Prop) (cost : Nat)
    (same : evaluateHOLFiniteState s program = evaluateHOLFiniteState s normalized)
    (reached : Reaches s normalized P cost tail) : Reaches s program P cost tail := by
  unfold Reaches at reached ⊢
  rw [same]
  exact reached

/-- The actual legacy suffix — two zero stores at record offsets 232 and 240 — keeps the
carry. -/
theorem header_carry_legacy_suffix {F : Type} (s next : PanSemStateFiniteExact 64 F)
    (array count input inputLength scratch frame record word : BitVec 64) (ceiling inputLimit : Nat)
    (env : HeaderCarryEnv s array count input inputLength scratch frame record ceiling inputLimit)
    (carry : HeaderSuffixCarry s next array count input inputLength record word) :
    Reaches next (.seq decodeHeaderLegacySuffix (decodeHeaderAt 57))
      (fun post => HeaderSuffixCarry s post array count input inputLength record word) 0 (decodeHeaderAt 57) := by
  have rootMem := carry.1
  have tableN := carry.2.2.2.2.1
  have atArrayN := carry.2.2.2.2.2.1
  have atRecordN := carry.2.2.2.2.2.2
  have rootApart232 : record + 32#64 ≠ record + BitVec.ofNat 64 232 :=
    record_root_apart record 232 env.recordFits (by decide) (by decide)
  have rootApart240 : record + 32#64 ≠ record + BitVec.ofNat 64 240 :=
    record_root_apart record 240 env.recordFits (by decide) (by decide)
  have first := header_expression_store_frame next record 0 232 (.const 0)
    (.seq (headerExpressionStore (.const 0) 240) (decodeHeaderAt 57)) (env.codeAt carry) atRecordN
    (by simp [evalHOLExact])
  have chain : Reaches next (.seq (headerExpressionStore (.const 0) 232)
      (.seq (headerExpressionStore (.const 0) 240) (decodeHeaderAt 57)))
      (fun post => HeaderSuffixCarry s post array count input inputLength record word) 0 (decodeHeaderAt 57) := by
    apply reaches_trans next _ (.seq (headerExpressionStore (.const 0) 240) (decodeHeaderAt 57)) (decodeHeaderAt 57)
      _ _ 0 0 first
    intro parsed facts
    obtain ⟨localsP,domainP,codeP,globalsP,memoryP⟩ := facts
    have belowP : ∀ address : BitVec 64, address.toNat < record.toNat → parsed.memory address = next.memory address :=
      fun address low => memoryP address (record_below_apart record 232 address env.recordFits (by decide) low)
    have tableP : RlpSliceInputPrefix parsed array input inputLength count.toNat :=
      tableN.after_memory_below next parsed array count input inputLength record env.before domainP belowP
    have atArrayP : parsed.locals.lookup (ofString "arr") = some (.val (.word array)) := by
      rw [localsP]; exact atArrayN
    have atRecordP : parsed.locals.lookup (ofString "h") = some (.val (.word record)) := by
      rw [localsP]; exact atRecordN
    have carryP : HeaderSuffixCarry s parsed array count input inputLength record word :=
      header_carry_intro s next parsed array count input inputLength record word carry
        ((memoryP (record + 32#64) rootApart232).trans rootMem) domainP codeP globalsP tableP atArrayP atRecordP
    have second := header_expression_store_frame parsed record 0 240 (.const 0) (decodeHeaderAt 57)
      (codeP.trans (env.codeAt carry)) atRecordP (by simp [evalHOLExact])
    apply reaches_mono parsed _ (decodeHeaderAt 57) _ _ 0 0 (le_refl _) ?_ second
    intro post kept
    obtain ⟨localsPost,domainPost,codePost,globalsPost,memoryPost⟩ := kept
    have belowPost : ∀ address : BitVec 64, address.toNat < record.toNat →
        post.memory address = parsed.memory address :=
      fun address low => memoryPost address (record_below_apart record 240 address env.recordFits (by decide) low)
    have tablePost : RlpSliceInputPrefix post array input inputLength count.toNat :=
      tableP.after_memory_below parsed post array count input inputLength record env.before domainPost belowPost
    have atArrayPost : post.locals.lookup (ofString "arr") = some (.val (.word array)) := by
      rw [localsPost]; exact atArrayP
    have atRecordPost : post.locals.lookup (ofString "h") = some (.val (.word record)) := by
      rw [localsPost]; exact atRecordP
    exact header_carry_intro s parsed post array count input inputLength record word carryP
      ((memoryPost (record + 32#64) rootApart240).trans (carryP.1)) domainPost codePost globalsPost tablePost
      atArrayPost atRecordPost
  exact header_reaches_same_evaluation next (.seq decodeHeaderLegacySuffix (decodeHeaderAt 57)) _
    (decodeHeaderAt 57) _ 0 (by unfold decodeHeaderLegacySuffix; exact evaluate_seq_assoc next _ _ _) chain

/-- Lift the carry over one actual record step that writes a single word at a record
offset other than 32, keeping the table by the ceiling-based frame. -/
theorem header_carry_of_apart_step {F : Type} (s next post : PanSemStateFiniteExact 64 F)
    (array count input inputLength scratch frame record word : BitVec 64) (ceiling inputLimit : Nat)
    (env : HeaderCarryEnv s array count input inputLength scratch frame record ceiling inputLimit)
    (carry : HeaderSuffixCarry s next array count input inputLength record word)
    (name : MlS) (stepWord : BitVec 64) (offset : Nat)
    (rootAbove : ceiling ≤ (record + 32#64).toNat) (offsetBound : offset < 248) (different : offset ≠ 32)
    (differentArray : name ≠ ofString "arr") (differentRecord : name ≠ ofString "h")
    (atArray : next.locals.lookup (ofString "arr") = some (.val (.word array)))
    (atRecord : next.locals.lookup (ofString "h") = some (.val (.word record)))
    (locals : post.locals = next.locals.update (name,.val (.word stepWord)))
    (domain : post.memaddrs = next.memaddrs) (code : post.code = next.code)
    (globals : ∀ global : MlS, post.globals.lookup global = next.globals.lookup global)
    (tablePost : RlpSliceInputPrefix post array input inputLength count.toNat)
    (memory : ∀ address : BitVec 64, ceiling ≤ address.toNat → address ≠ record + BitVec.ofNat 64 offset →
      post.memory address = next.memory address) :
    HeaderSuffixCarry s post array count input inputLength record word := by
  have atArrayPost : post.locals.lookup (ofString "arr") = some (.val (.word array)) := by
    rw [locals]
    simpa (config := {decide := true}) [HolFiniteMapExact.lookup_update,FUPDATE,differentArray] using atArray
  have atRecordPost : post.locals.lookup (ofString "h") = some (.val (.word record)) := by
    rw [locals]
    simpa (config := {decide := true}) [HolFiniteMapExact.lookup_update,FUPDATE,differentRecord] using atRecord
  exact header_carry_intro s next post array count input inputLength record word carry
    ((memory (record + 32#64) rootAbove (record_root_apart record offset env.recordFits offsetBound different)).trans
      carry.1) domain code globals tablePost atArrayPost atRecordPost

#print axioms header_carry_of_apart_step

/-- The actual current suffix — field 21 into offset 232, the field 22 numeric call into
local `bg` and field 22's word at offset 240 — keeps the carry. -/
theorem header_carry_current_suffix {F : Type} (s next : PanSemStateFiniteExact 64 F)
    (array count input inputLength scratch frame record word : BitVec 64) (ceiling inputLimit : Nat)
    (env : HeaderCarryEnv s array count input inputLength scratch frame record ceiling inputLimit)
    (carry : HeaderSuffixCarry s next array count input inputLength record word)
    (countBound : 23 ≤ count.toNat)
    (clock : (headerRlpFieldCost inputLimit + 1) +
      ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35)) ≤ next.clock) :
    Reaches next (.seq decodeHeaderCurrentSuffix (decodeHeaderAt 57))
      (fun post => HeaderSuffixCarry s post array count input inputLength record word)
      ((headerRlpFieldCost inputLimit + 1) +
        ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35))) (decodeHeaderAt 57) := by
  have rootAbove : ceiling ≤ (record + 32#64).toNat :=
    record_offset_above_ceiling array count record ceiling 32 env.above env.before (by decide) env.recordFits
  have atArrayNext := carry.2.2.2.2.2.1
  have atRecordNext := carry.2.2.2.2.2.2
  have tableNext := carry.2.2.2.2.1
  have bytes := header_bytes_step_content_frame next array count input inputLength scratch frame record ceiling inputLimit
    (21#64) (32#64) 232 headerCurrentUintContinuation (by decide) atArrayNext atRecordNext env.before env.recordFits
    tableNext (by simpa using (show 21 < count.toNat by omega)) env.above env.fits env.inputBound env.limitBound
    (env.scratchGlobalAt carry) (env.frameGlobalAt carry) (env.codeAt carry) env.orderedFrame env.framePositive
    env.scratchBelow (env.arenaAt carry) (by omega)
  have stage1 : Reaches next (headerBytesStep (21#64) (32#64) 232 headerCurrentUintContinuation)
      (fun post => HeaderSuffixCarry s post array count input inputLength record word)
      (headerRlpFieldCost inputLimit + 1) headerCurrentUintContinuation := by
    apply reaches_mono next _ _ _ _ _ _ (le_refl _) ?_ bytes
    intro post facts
    obtain ⟨stepWord,locals,_,_,tablePost,domain,code,globals,memory⟩ := facts
    exact header_carry_of_apart_step s next post array count input inputLength scratch frame record word ceiling inputLimit
      env carry (ofString "f") stepWord 232 rootAbove (by decide) (by decide) (by decide) (by decide)
      atArrayNext atRecordNext locals domain code globals tablePost memory
  have stage2 : ∀ (entry : PanSemStateFiniteExact 64 F),
      HeaderSuffixCarry s entry array count input inputLength record word →
      ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35)) ≤ entry.clock →
      Reaches entry headerCurrentUintContinuation
        (fun post => HeaderSuffixCarry s post array count input inputLength record word)
        ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35)) (decodeHeaderAt 57) := by
    intro entry carried budget
    obtain ⟨pointer,length,sliceEntry⟩ :=
      carried.2.2.2.2.1 (22#64) (by simpa using (show 22 < count.toNat by omega))
    have atArrayEntry := carried.2.2.2.2.2.1
    have atRecordEntry := carried.2.2.2.2.2.2
    have args : evalListHOLFinite entry (h := fun a => Classical.propDecidable (entry.memaddrs a))
        [.var .local (ofString "arr"),.const 22,.const 8] =
        some (headerRlpFieldValues .uint array 22 8) := by
      rw [evalListHOLFinite_eq_toExact]
      simp [evalListHOLExact,evalHOLExact,atArrayEntry,headerRlpFieldValues]
    have call := header_rlp_field_assignment_reaches entry .uint array 22 8 pointer length input inputLength
      scratch frame ceiling inputLimit (ofString "bg")
      [.var .local (ofString "arr"),.const 22,.const 8] headerCurrentWordContinuation args sliceEntry
      env.inputBound env.limitBound (env.scratchGlobalAt carried) (env.frameGlobalAt carried) (env.codeAt carried)
      env.orderedFrame env.framePositive env.scratchBelow (env.arenaAt carried) (by omega)
    have callReady : Reaches entry headerCurrentUintContinuation
        (fun post => HeaderSuffixCarry s post array count input inputLength record word)
        (headerRlpFieldCost inputLimit + 1) headerCurrentWordContinuation := by
      unfold headerCurrentUintContinuation
      apply reaches_mono entry _ _ _ _ _ _ (le_refl _) ?_ call
      intro post facts
      obtain ⟨value,locals,_,domain,code,globals,memory⟩ := facts
      have tablePost : RlpSliceInputPrefix post array input inputLength count.toNat :=
        (carried.2.2.2.2.1).after_memory_from_ceiling entry post array count input inputLength ceiling env.above env.fits
          domain memory
      have atArrayPost : post.locals.lookup (ofString "arr") = some (.val (.word array)) := by
        rw [locals]
        simpa (config := {decide := true}) [HolFiniteMapExact.lookup_update,FUPDATE] using atArrayEntry
      have atRecordPost : post.locals.lookup (ofString "h") = some (.val (.word record)) := by
        rw [locals]
        simpa (config := {decide := true}) [HolFiniteMapExact.lookup_update,FUPDATE] using atRecordEntry
      exact header_carry_intro s entry post array count input inputLength record word carried
        ((memory (record + 32#64) rootAbove).trans carried.1) domain code globals tablePost atArrayPost atRecordPost
    have tail : ∀ (entry2 : PanSemStateFiniteExact 64 F),
        HeaderSuffixCarry s entry2 array count input inputLength record word →
        (headerRlpFieldCost inputLimit + 35) ≤ entry2.clock →
        Reaches entry2 headerCurrentWordContinuation
          (fun post => HeaderSuffixCarry s post array count input inputLength record word)
          (headerRlpFieldCost inputLimit + 35) (decodeHeaderAt 57) := by
      intro entry2 carried2 budget2
      obtain ⟨rootMem2,domain2,codeEq2,globals2,table2,atArray2,atRecord2⟩ := carried2
      have carryKept : HeaderSuffixCarry s entry2 array count input inputLength record word :=
        ⟨rootMem2,domain2,codeEq2,globals2,table2,atArray2,atRecord2⟩
      have wordStep := header_word_field_step_content_frame entry2 array count input inputLength scratch frame record
        ceiling inputLimit (22#64) 240 (decodeHeaderAt 57) (by decide) atArray2 atRecord2 env.before env.recordFits
        table2 (by simpa using (show 22 < count.toNat by omega)) env.above env.fits env.inputBound
        env.limitBound (env.scratchGlobalAt carryKept) (env.frameGlobalAt carryKept) (env.codeAt carryKept)
        env.orderedFrame env.framePositive env.scratchBelow (env.arenaAt carryKept) budget2
      unfold headerCurrentWordContinuation
      apply reaches_mono entry2 _ _ _ _ _ _ (le_refl _) ?_ wordStep
      intro post facts
      obtain ⟨stepWord,_,_,locals,tablePost,domain,code,globals,memory⟩ := facts
      exact header_carry_of_apart_step s entry2 post array count input inputLength scratch frame record word ceiling
        inputLimit env carryKept (ofString "w") stepWord 240 rootAbove (by decide) (by decide) (by decide) (by decide)
        atArray2 atRecord2 locals domain code globals tablePost memory
    exact reaches_trans_budget entry headerCurrentUintContinuation headerCurrentWordContinuation (decodeHeaderAt 57)
      (fun post => HeaderSuffixCarry s post array count input inputLength record word)
      (fun post => HeaderSuffixCarry s post array count input inputLength record word)
      (headerRlpFieldCost inputLimit + 1) (headerRlpFieldCost inputLimit + 35) (by omega) callReady tail
  have chain := reaches_trans_budget next (headerBytesStep (21#64) (32#64) 232 headerCurrentUintContinuation)
    headerCurrentUintContinuation (decodeHeaderAt 57)
    (fun post => HeaderSuffixCarry s post array count input inputLength record word)
    (fun post => HeaderSuffixCarry s post array count input inputLength record word)
    (headerRlpFieldCost inputLimit + 1)
    ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35)) (by omega) stage1 stage2
  have same := evaluate_header_current_suffix_normalized next
  exact header_reaches_same_evaluation next (.seq decodeHeaderCurrentSuffix (decodeHeaderAt 57))
    (headerBytesStep (21#64) (32#64) 232 headerCurrentUintContinuation) (decodeHeaderAt 57) _ _ same chain

#print axioms header_carry_current_suffix

/-- The actual suffix phase `decodeHeaderAt 56 -> 57`: whichever of the current and the
legacy suffix the header flag selects, the carry survives to the returned pointer. -/
theorem header_carry_suffix {F : Type} (s next : PanSemStateFiniteExact 64 F)
    (array count input inputLength scratch frame record word : BitVec 64) (ceiling inputLimit : Nat)
    (env : HeaderCarryEnv s array count input inputLength scratch frame record ceiling inputLimit)
    (carry : HeaderSuffixCarry s next array count input inputLength record word)
    (flag : BitVec 64)
    (atFlag : next.locals.lookup (ofString "is_current") = some (.val (.word flag)))
    (currentBound : flag ≠ 0 → 23 ≤ count.toNat)
    (clock : (headerRlpFieldCost inputLimit + 1) +
      ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35)) ≤ next.clock) :
    Reaches next (decodeHeaderAt 56)
      (fun post => HeaderSuffixCarry s post array count input inputLength record word)
      ((headerRlpFieldCost inputLimit + 1) +
        ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35))) (decodeHeaderAt 57) := by
  by_cases zero : flag = (0#64)
  · have legacy := header_carry_legacy_suffix s next array count input inputLength scratch frame record word ceiling
      inputLimit env carry
    have selected : evaluateHOLFiniteState next
        (.ite decodeHeaderCurrentCondition decodeHeaderCurrentSuffix decodeHeaderLegacySuffix) =
        evaluateHOLFiniteState next decodeHeaderLegacySuffix := by
      simp [evaluateHOLFiniteState_ite,decodeHeaderCurrentCondition,evalHOLExact,atFlag,zero,
        Compiler.Encoders.Asm.wordCmpHOL]
    have same : evaluateHOLFiniteState next (decodeHeaderAt 56) =
        evaluateHOLFiniteState next (.seq decodeHeaderLegacySuffix (decodeHeaderAt 57)) := by
      rw [source_decode_header_current_suffix,evaluateHOLFiniteState_seq_line780,selected,
        ← evaluateHOLFiniteState_seq_line780]
    exact header_reaches_same_evaluation next _ _ (decodeHeaderAt 57) _ _ same
      (reaches_mono next _ _ _ _ 0 _ (by omega) (fun _ kept => kept) legacy)
  · have current := header_carry_current_suffix s next array count input inputLength scratch frame record word ceiling
      inputLimit env carry (currentBound zero) clock
    have selected : evaluateHOLFiniteState next
        (.ite decodeHeaderCurrentCondition decodeHeaderCurrentSuffix decodeHeaderLegacySuffix) =
        evaluateHOLFiniteState next decodeHeaderCurrentSuffix := by
      simp [evaluateHOLFiniteState_ite,decodeHeaderCurrentCondition,evalHOLExact,atFlag,zero,
        Compiler.Encoders.Asm.wordCmpHOL]
    have same : evaluateHOLFiniteState next (decodeHeaderAt 56) =
        evaluateHOLFiniteState next (.seq decodeHeaderCurrentSuffix (decodeHeaderAt 57)) := by
      rw [source_decode_header_current_suffix,evaluateHOLFiniteState_seq_line780,selected,
        ← evaluateHOLFiniteState_seq_line780]
    exact header_reaches_same_evaluation next _ _ (decodeHeaderAt 57) _ _ same current

#print axioms header_carry_suffix
end InitECandidate.Runtime
