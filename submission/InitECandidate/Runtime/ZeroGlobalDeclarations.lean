def zeroGlobalDeclarations {width : Nat} [NeZero width] (names : List MlS) : List (DeclHOL width) :=
  names.map (fun name => .decl .one name (.const 0))

def zeroGlobalPost {width : Nat} [NeZero width] {F : Type}
    (state : PanSemStateFiniteExact width F) (names : List MlS) : PanSemStateFiniteExact width F :=
  names.foldl (fun current name => setGlobalHOLFinite name (.val (.word 0)) current) state

/-- Literal zero globals initialize for every memory, oracle and source clock. -/
theorem zero_global_declarations_evaluate {width : Nat} [NeZero width] {F : Type}
    (names : List MlS) (state : PanSemStateFiniteExact width F) [DecidablePred state.memaddrs] :
    evaluateDeclsHOLFinite state (zeroGlobalDeclarations (width := width) names) =
      some (zeroGlobalPost state names) := by
  induction names generalizing state with
  | nil => rfl
  | cons name names ih =>
    letI : DecidablePred (setGlobalHOLFinite name (.val (.word 0)) state).memaddrs := inferInstanceAs (DecidablePred state.memaddrs)
    simp only [zeroGlobalDeclarations, List.map_cons, evaluateDeclsHOLFinite,
      evalHOLFinite, evalHOLExact, shapeOfHOLExact, shapeEqHOL, zeroGlobalPost, List.foldl_cons]
    change evaluateDeclsHOLFinite (setGlobalHOLFinite name (.val (.word 0)) state)
      (zeroGlobalDeclarations names) = some (zeroGlobalPost (setGlobalHOLFinite name (.val (.word 0)) state) names)
    exact ih _

noncomputable def baselineGlobalNames : List MlS :=
  FrontendStages.Declarations.globalDeclarations.filterMap (fun declaration =>
    match declaration with | .decl _ name _ => some name | _ => none)

