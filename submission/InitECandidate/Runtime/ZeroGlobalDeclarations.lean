theorem canonical_source_globals_evaluate (input : Guest.InputBlob) :
    @evaluateDeclsHOLFinite 64 Guest.HostMemory _ (canonicalGlobalsSourceState input)
      (fun address => Classical.propDecidable ((canonicalGlobalsSourceState input).memaddrs address))
      FrontendStages.Declarations.globalDeclarations =
      some (zeroGlobalPost (canonicalGlobalsSourceState input) baselineGlobalNames) := by
  classical
  rw [baseline_global_declarations_zero]
  exact zero_global_declarations_evaluate _ _

