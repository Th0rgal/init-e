/-! Every pinned Loop body passes the caller+callee site walk at its entry
label `(name, 2)`: each returning call's WordSimp site charge is at most the
certified table entry for its caller and static target. -/

/-- The site certificate for one pinned Loop body. -/
def LsOk (x : Nat × List Nat × HolLoopProg 64) : Prop := SiteLe siteA siteB (x.1, 2) x.2.2

theorem ls_conv (x : Nat × List Nat × HolLoopProg 64) (h : (siteW siteA siteB (x.1, 2) x.2.2).isSome = true) : LsOk x := by
  obtain ⟨l', hl⟩ := Option.isSome_iff_exists.1 h
  exact (siteW_sound siteA siteB _ _ _ hl).1

