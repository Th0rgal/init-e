/-- A found callee is the code-table entry at its callee name. -/
theorem findCode_lookup {target : Option Nat} {values : List (WordLocW 64)}
    {code : Spt (List Nat × HolLoopProg 64)} {env : Spt (WordLocW 64)} {prog : HolLoopProg 64}
    (h : LoopSemStateFiniteExact.findCode target values code = some (env, prog)) :
    ∃ ps, sptLookup (calleeName target values) code = some (ps, prog) := by
  cases target with
  | some t =>
    simp only [LoopSemStateFiniteExact.findCode] at h
    split at h
    · cases h
    · rename_i ps body hl
      split at h
      · cases h; exact ⟨ps, by simpa [calleeName] using hl⟩
      · cases h
  | none =>
    cases values with
    | nil => simp [LoopSemStateFiniteExact.findCode] at h
    | cons a rest =>
      simp only [LoopSemStateFiniteExact.findCode] at h
      split at h
      · rename_i loc hlast
        split at h
        · cases h
        · rename_i ps body hl
          split at h
          · cases h
            refine ⟨ps, ?_⟩
            have : (a :: rest).getLast? = some (.loc loc 0) := by
              rw [List.getLast?_eq_getLast (by simp)]; rw [hlast]
            simp only [calleeName, this]; exact hl
          · cases h
      · cases h

/-- Every callee body of a Loop state whose code table holds only pinned Loop
outputs passes the site walk. -/
theorem codeSiteLe_of_outputs {F : Type} (s : LoopSemStateFiniteExact 64 F)
    (hcode : ∀ n ps prog, sptLookup n s.code = some (ps, prog) → (n, ps, prog) ∈ InitECandidate.Proofs.FrontendStages.Loop.outputs) :
    CodeSiteLe siteA siteB s := by
  intro target values env prog found
  obtain ⟨ps, hl⟩ := findCode_lookup found
  exact ls_all_ok _ (hcode _ _ _ hl)

#print axioms codeSiteLe_of_outputs
