theorem ls_step33 (t : List (Nat × List Nat × HolLoopProg 64)) (ht : ∀ x ∈ t, LsOk x) :
    ∀ x ∈ InitECandidate.Proofs.FrontendStages.Loop.output825 :: t, LsOk x := by
  intro x hx
  rcases List.mem_cons.1 hx with h | hx
  · subst h; exact ls_conv _ (lsChunk33_ok _ (by unfold lsChunk33; exact List.mem_cons_self ..))
  exact ht x hx

