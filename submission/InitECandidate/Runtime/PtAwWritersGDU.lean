section sa
variable {D : BitVec 64 → Prop} {B : Bool} {w : BitVec 64} {SP0 P0 FM : BitVec 64} {G0 : GA}
  {J C SKB Bo U Sc : BitVec 64}

/-- The actual `set_account(addr, a)` body: the accounts-written table at `ts + 16` stays ready. -/
theorem setAccount_rv_aqgdU (Ts Taw A V Nj H0 Hl : BitVec 64) (l : TLay) (S : Set (BitVec 64)) (M0 : Mem)
    (hTs : G0.lookup (ofString "ts") = some (.val (.word Ts))) (cell : M0 (Ts + 16#64) = .word Taw)
    (rv : TabRV D B Taw l Hl S M0) (hHl : Hl.toNat ≤ H0.toNat)
    (below : ∀ x, TabPhys Taw l x → x.toNat < H0.toNat) (jsep : ∀ x, InJ J C x → ¬ TabPhys Taw l x)
    (p0 : P0.toNat ≤ H0.toNat) (jfit : J.toNat + C.toNat * 32 ≤ 33806089496) (hwJ : ¬ InJ J C w)
    (hwP : w.toNat < P0.toNat) (hwT : ¬ TabPhys Taw l w)
    (Dall : ∀ a : BitVec 64, a.toNat < 33806089496 → D a)
    (sup : l.KL = 20 ∨ l.KL = 32 ∨ l.KL = 52) (sd : l.SD.toNat ≤ 56) (hV : V ∈ S)
    (hKE : A.toNat + 52 ≤ 33806089496) :
    AQGD D B (JWSBUS SP0 P0 FM G0 J C SKB Bo U Sc) w (fun _ => False)
      (fun L M G => (L.lookup (ofString "addr") = some (.val (.word A)) ∧
        L.lookup (ofString "a") = some (.val (.word V))) ∧ M = M0 ∧ HeapIs G H0 ∧
        G.lookup (ofString "journal_n") = some (.val (.word Nj)))
      (fun _ _ _ => True) (fun _ M' G' => JSRV D B Taw l S J C Nj H0 M0 M' G')
      (sourceFunctionBody Guest.guestFn_set_account) := by
  rw [setAccount_body_eq]
  refine aqgd_seq (Q := fun _ M G => JSRV D B Taw l S J C Nj H0 M0 M G)
    (aqgd_callSpec (Vn' := fun _ => False)
      (Pe := fun _ M0' G0' L M G => JL Taw A V L ∧ M = M0' ∧ G = G0')
      (RRe := fun _ _ _ _ M' G' => JSRV D B Taw l S J C Nj H0 M0 M' G')
      _ _ _ _ _ originalRuntimeCode_journalSet_lookup (by simp) ?_ ?_ (fun _ _ _ _ _ _ _ h => h))
    (aqgd_return _ (fun s v G _ hG h _ _ => by unfold GIs at hG; subst hG; exact h))
  · intro L0 M0' G0' ⟨_,hM,hH,hn⟩
    subst hM
    exact aqgd_conseq (jset_rv_aqgdU Taw A V Nj H0 Hl l S M0' rv hHl below jsep p0 jfit hwJ hwP hwT Dall sup sd hV hKE) (fun L M G ⟨jl,hM',hG'⟩ => ⟨jl,hM',by rw [hG']; exact hH,by rw [hG']; exact hn⟩)
      (fun _ _ _ _ => trivial) (fun _ _ _ h => h)
  · intro F s values callee rs aw H hG ⟨⟨ha,hv⟩,hM,_⟩ _ args lookup
    unfold GIs at hG; subst hG
    obtain ⟨v1,vs,rfl,e1,r1⟩ := evalList_cons' s _ _ _ args
    obtain ⟨v2,vs2,rfl,e2,r2⟩ := evalList_cons' s _ _ _ r1
    obtain ⟨v3,vs3,rfl,e3,r3⟩ := evalList_cons' s _ _ _ r2
    have := evalList_nil' s _ r3; subst this
    have hts : s.globals.lookup (ofString "ts") = some (.val (.word Ts)) :=
      (aw.1.1.1.1.1.2.2.2 (ofString "ts") (by decide)).1.trans hTs
    rw [ev_load_goff s _ Ts 16#64 v1 hts e1,hM,cell] at *
    simp [EV,evalHOLExact,ha] at e2
    simp [EV,evalHOLExact,hv] at e3
    subst e2 e3
    rw [pan_three_word_lookup _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide)
      originalRuntimeCode_journalSet_lookup] at lookup
    simp only [Option.some.injEq,Prod.mk.injEq] at lookup
    obtain ⟨_,rfl,_⟩ := lookup
    exact ⟨⟨by simp (config := {decide := true}) [HolFiniteMapExact.lookup_update,FUPDATE],
      by simp (config := {decide := true}) [HolFiniteMapExact.lookup_update,FUPDATE],
      by simp (config := {decide := true}) [HolFiniteMapExact.lookup_update,FUPDATE]⟩,rfl,rfl⟩

#print axioms setAccount_rv_aqgdU
end sa
end InitECandidate.Runtime
