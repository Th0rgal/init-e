def goodMem (function : MlS) : Bool := goodMemList.contains function

theorem program_check_mem : (functionsHOL sourceDeclarations).all
    (fun entry => !(goodMem entry.1) || keepsM goodMem entry.2.2.1) = true := by
  decide_cbv

theorem goodMem_bodies : ∀ function, goodMem function = true → ∀ values body callee rs,
    lookupCodeHOLFinite originalRuntimeCode.lookup function values = some (body,callee,rs) →
    keepsM goodMem body = true := by
  intro f hf values body callee rs h
  obtain ⟨params,rs',hc⟩ := lookupCode_installed h
  have := List.all_eq_true.mp program_check_mem _ (originalRuntimeCode_mem hc)
  simpa [hf] using this

theorem keepsMem_of_installed {f : MlS} {params : List (MlS × ShapeHOL)} {body : ProgHOL 64} {rs : ShapeHOL}
    (h : originalRuntimeCode.lookup f = some (params,body,rs)) (hf : goodMem f = true) :
    keepsM goodMem body = true := by
  have := List.all_eq_true.mp program_check_mem _ (originalRuntimeCode_mem h)
  simpa [hf] using this

/-- An installed memory-keeping original function's body keeps memory, at every fuel and in every outcome. -/
theorem evaluate_keeps_mem {F : Type} (program : ProgHOL 64) (supported : keepsM goodMem program = true)
    (state : PanSemStateFiniteExact 64 F) (code : state.code = originalRuntimeCode) :
    (evaluateHOLFiniteState state program).2.memory = state.memory :=
  evaluate_keepsM goodMem goodMem_bodies program supported state code

#print axioms program_check_mem
#print axioms evaluate_keeps_mem
end InitECandidate.Runtime
