import InitECandidate.Runtime.AllocMoveTable
namespace InitECandidate.Runtime.FineCost
open Flapjack InitECandidate.Proofs.BackendStages InitECandidate.Proofs.BackendStages.Native

/-! Per-function move tables of the pinned allocated Word program (`programs0`).
For each function label the table records, as maxima over the function's
allocated code:

* `calls`: per callee, the moves of a call site (the move run before the call
  plus the larger of its return continuation's moves and its handler's leading
  and trailing runs);
* `merge`: the trailing move run of an `ite` branch (branch-merge moves);
* `loop`: the leading plus trailing move runs of a loop body (loop reconcile);
* `ret`, `raise`, `other`: the move run before a `return`, a `raise`, and an
  `ffi`/`alloc`/`install`.

`goTab` checks a function's code against its table in one forced pass; the
check holds for every function of `programs0` by kernel evaluation per Chunk.
The navigation lemmas give each bound at its node. -/

/-- A function's move table. -/
structure FunctionTable where
  calls : List (Option Nat × Nat)
  merge : Nat
  loop : Nat
  ret : Nat
  raise : Nat
  other : Nat
  deriving Inhabited

/-- The move bound of a call to `target` in a function with table `t`. -/
def FunctionTable.call (t : FunctionTable) (target : Option Nat) : Nat :=
  match t.calls.find? (fun c => c.1 == target) with
  | some c => c.2
  | none => 0

