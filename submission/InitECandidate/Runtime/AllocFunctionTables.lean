/-- Tables of every function of `programs0`, by label. -/
def functionTables : List (Nat × FunctionTable) :=
  functionTables0 ++ functionTables1 ++ functionTables2 ++ functionTables3 ++ functionTables4 ++ functionTables5 ++ functionTables6 ++ functionTables7 ++ functionTables8 ++ functionTables9 ++ functionTables10 ++ functionTables11 ++ functionTables12 ++ functionTables13 ++ functionTables14 ++ functionTables15 ++ functionTables16

/-- The table of a function label. -/
def tableOf (label : Nat) : FunctionTable :=
  match functionTables.find? (fun entry => entry.1 == label) with
  | some entry => entry.2
  | none => default

/-- The table check, given the moves running into the program; returns whether
every site is within the table, and the moves running out. -/
def goTab (t : FunctionTable) : Nat → WordLangProgHOL (BitVec 64) → Bool × Nat
  | before, .seq a b =>
    match goTab t before a with
    | (true, after) => goTab t after b
    | (false, _) => (false, 0)
  | before, .move _ pairs => (true, before + allocMovePrice pairs)
  | before, .tick => (true, before)
  | before, .skip => (true, before)
  | before, .call rets target args h =>
    (decide (before + callAfterMoves (.call rets target args h) ≤ t.call target) &&
      (match rets with | some (_, _, k, _, _) => (goTab t 0 k).1 | none => true) &&
      (match h with | some (_, hp, _, _) => (goTab t 0 hp).1 | none => true), 0)
  | _, .ite _ _ _ a b =>
    (decide (max (trailingMoves a).1 (trailingMoves b).1 ≤ t.merge) &&
      (goTab t 0 a).1 && (goTab t 0 b).1, 0)
  | _, .loop _ b _ =>
    (decide ((leadingMoves b).1 + (trailingMoves b).1 ≤ t.loop) && (goTab t 0 b).1, 0)
  | _, .mustTerminate b => ((goTab t 0 b).1, 0)
  | before, .return _ _ => (decide (before ≤ t.ret), 0)
  | before, .raise _ => (decide (before ≤ t.raise), 0)
  | before, .ffi _ _ _ _ _ _ => (decide (before ≤ t.other), 0)
  | before, .alloc _ _ => (decide (before ≤ t.other), 0)
  | before, .install _ _ _ _ _ => (decide (before ≤ t.other), 0)
  | _, _ => (true, 0)

theorem goTab_seq {t before a b} (ok : (goTab t before (.seq a b)).1 = true) :
    (goTab t before a).1 = true ∧ (goTab t (goTab t before a).2 b).1 = true := by
  simp only [goTab] at ok
  split at ok
  · rename_i after h
    rw [h]
    exact ⟨rfl, ok⟩
  · cases ok

/-- A call site's moves are within its function's table entry for the callee. -/
theorem goTab_call {t before rets target args h}
    (ok : (goTab t before (.call rets target args h)).1 = true) :
    before + callAfterMoves (.call rets target args h) ≤ t.call target := by
  unfold goTab at ok
  simp only [Bool.and_eq_true, decide_eq_true_eq] at ok
  exact ok.1.1

theorem goTab_call_return {t before r c k l1 l2 target args h}
    (ok : (goTab t before (.call (some (r, c, k, l1, l2)) target args h)).1 = true) :
    (goTab t 0 k).1 = true := by
  unfold goTab at ok
  simp only [Bool.and_eq_true] at ok
  exact ok.1.2

theorem goTab_call_handler {t before rets target args n hp l1 l2}
    (ok : (goTab t before (.call rets target args (some (n, hp, l1, l2)))).1 = true) :
    (goTab t 0 hp).1 = true := by
  unfold goTab at ok
  simp only [Bool.and_eq_true] at ok
  exact ok.2

/-- Branch-merge moves are within the table. -/
theorem goTab_ite {t before op c r a b}
    (ok : (goTab t before (.ite op c r a b)).1 = true) :
    max (trailingMoves a).1 (trailingMoves b).1 ≤ t.merge ∧
      (goTab t 0 a).1 = true ∧ (goTab t 0 b).1 = true := by
  unfold goTab at ok
  simp only [Bool.and_eq_true, decide_eq_true_eq] at ok
  exact ⟨ok.1.1, ok.1.2, ok.2⟩

/-- Loop reconcile moves are within the table. -/
theorem goTab_loop {t before i b o}
    (ok : (goTab t before (.loop i b o)).1 = true) :
    (leadingMoves b).1 + (trailingMoves b).1 ≤ t.loop ∧ (goTab t 0 b).1 = true := by
  unfold goTab at ok
  simp only [Bool.and_eq_true, decide_eq_true_eq] at ok
  exact ok

theorem goTab_mustTerminate {t before b}
    (ok : (goTab t before (.mustTerminate b)).1 = true) : (goTab t 0 b).1 = true := by
  unfold goTab at ok
  exact ok

/-- The move run before a `return` is within the table. -/
theorem goTab_return {t before l vs}
    (ok : (goTab t before (.return l vs)).1 = true) : before ≤ t.ret := by
  unfold goTab at ok
  simpa using ok

/-- The move run before a `raise` is within the table. -/
theorem goTab_raise {t before n}
    (ok : (goTab t before (.raise n)).1 = true) : before ≤ t.raise := by
  unfold goTab at ok
  simpa using ok

/-- A function of the fixed program meets its table. -/
def tableOk (entry : Nat × Nat × WordLangProgHOL (BitVec 64)) : Bool :=
  (goTab (tableOf entry.1) 0 entry.2.2).1

