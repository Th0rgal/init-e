import InitECandidate.Runtime.PtKeyUSetGD
/-! `PtTabSet2GD` without the key-alignment premise (generated by awugen): the key may have any alignment;
the actual `htab_set` uses `set_call_all_plans_values_inAny`. -/
namespace InitECandidate.Runtime
open Flapjack Flapjack.Pancake.PanLang Flapjack.PanSemStateFiniteExact
open Flapjack.Basis.Pure.MlString


/-- `setRV_post` with the exit layout located. -/
theorem setRV_post2U {F : Type} {D : BitVec 64 → Prop} {B : Bool} (s post : PanSemStateFiniteExact 64 F)
    (T K V Hc Hl : BitVec 64) (l : TLay) (S : Set (BitVec 64)) (et ek ev : ExpHOL 64)
    (hd : s.memaddrs = D) (hb : s.be = B) (code : s.code = originalRuntimeCode)
    (Dall : ∀ a : BitVec 64, a.toNat < 33806089496 → D a)
    (rv : TabRV D B T l Hl S s.memory)
    (hH : s.globals.lookup (ofString "heap_ptr") = some (.val (.word Hc))) (le : Hl.toNat ≤ Hc.toNat)
    (hHE : Hc.toNat ≤ 33806089496) (al : Hc.toNat % 8 = 0)
    (sup : l.KL = 20 ∨ l.KL = 32 ∨ l.KL = 52) (sd : l.SD.toNat ≤ 56) (hV : V ∈ S)
    (hKE : K.toNat + 52 ≤ 33806089496)
    (args : evalListHOLFinite (liftClock s (2 ^ 74))
      (h := fun a => Classical.propDecidable (s.memaddrs a)) [et,ek,ev] =
      some [.val (.word T),.val (.word K),.val (.word V)])
    (run : evaluateHOLFiniteState s (.call (some (none,none)) (ofString "htab_set") [et,ek,ev]) = (none,post)) :
    SetRV D B T l Hc S post.memory post.globals := by
  obtain ⟨F0,s0,P,hm,hd0,hb0,hc0,hP,hC,hT,rd,vi⟩ := rv
  let s' : PanSemStateFiniteExact 64 F := liftClock s (2 ^ 74)
  have rd' := rd.transferX (r := s') hm.symm (hd.trans hd0.symm) (hb.trans hb0.symm) (code.trans hc0.symm) hH
    (by have := rd.live.frontier.allocated; omega) hHE al
  have vi' := vi.transferX (r := s') hm.symm (hd.trans hd0.symm) (hb.trans hb0.symm)
  have lift := panPropsEvaluateAddClockEq (.call (some (none,none)) (ofString "htab_set") [et,ek,ev]) s none post
    (2 ^ 74) ⟨run,by simp⟩
  have lift' : evaluateHOLFiniteState s' (.call (some (none,none)) (ofString "htab_set") [et,ek,ev]) =
      (none,liftClock post (2 ^ 74)) := lift
  have eK : ∀ o : Nat, o < 52 → (K + BitVec.ofNat 64 o).toNat = K.toNat + o := fun o ho => by
    rw [BitVec.toNat_add]; simp; omega
  have klen : l.KL.toNat ≤ 52 := by rcases sup with h | h | h <;> simp [h]
  have hcap : l.C.toNat * 16 < 2 ^ 64 := by have := rd.live.arrays.endBound; omega
  have res := rd'.set_call_all_plans_values_inAny s' l.KL T Hc l.KS l.SD l.C l.US l.VS l.OS l.OPS l.N K V l.b sup S vi' hV sd
    (by show 2 ^ 74 ≤ s.clock + 2 ^ 74; omega)
    (fun safe a _ hi => by
      have := growPlan_end Hc l.C l.SD hcap safe
      show s.memaddrs a; rw [hd]; exact Dall a (by omega))
    et ek ev args hC (by omega)
    (fun o ho => by show s.memaddrs _; rw [hd]; exact Dall _ (by rw [eK o (by omega)]; omega))
    (fun o ho => by
      show s.memaddrs _; rw [hd]; refine Dall _ ?_
      rw [panByteAlign_toNat64,eK o (by omega)]
      have := Nat.div_mul_le_self (K.toNat + o) 8; omega)
  rcases res with ⟨post2,run2,rdy,vin,_,_,_,_,addrs,endian⟩ | ⟨ne,_⟩
  · rw [lift'] at run2
    simp only [Prod.mk.injEq,true_and] at run2
    subst run2
    rcases rdy with ⟨nc,_,rp⟩ | rp
    · exact ⟨⟨l.KL,l.SD,l.C,nc,l.KS,l.VS,l.US,l.OS,l.OPS,l.b⟩,Hc,rp.live.frontier.heap,le_refl _,
        ⟨F,liftClock post (2 ^ 74),Hc,rfl,addrs.trans hd,endian.trans hb,rp.live.arrays.code,le_refl _,hC,hT,rp,vin⟩,
        rfl,rfl,fun x hx => Or.inl hx⟩
    · have k1 := rp.live.arrays.keysBefore
      have k2 := rp.live.arrays.valuesBefore
      have k3 := rp.live.arrays.usedBefore
      have k4 := rp.live.arrays.orderBefore
      have k5 := rp.live.arrays.endBound
      have fa := rp.live.frontier.allocated
      have m : ((l.C * 2) * l.SD).toNat ≤ (l.C * 2).toNat * l.SD.toNat := by
        rw [BitVec.toNat_mul]; exact Nat.mod_le _ _
      have vlo : Hc.toNat ≤ (htabGrowValues Hc l.C l.SD).toNat := by
        have := (allocationEnd_covers Hc ((l.C * 2) * l.SD) (by omega)).1
        unfold htabGrowValues; omega
      refine ⟨⟨l.KL,l.SD,l.C * 2,l.N + 1,Hc,htabGrowValues Hc l.C l.SD,htabGrowUsed Hc l.C l.SD,
        htabGrowOrder Hc l.C l.SD,htabGrowOrderPos Hc l.C l.SD,l.b + 1⟩,_,rp.live.frontier.heap,by omega,
        ⟨F,liftClock post (2 ^ 74),_,rfl,addrs.trans hd,endian.trans hb,rp.live.arrays.code,le_refl _,?_,hT,rp,vin⟩,
        rfl,rfl,fun x hx => ?_⟩
      · show 1 < (l.C * 2).toNat
        rw [BitVec.toNat_mul]; simp; omega
      · dsimp only [TabPhys,InTabF] at hx ⊢
        rcases hx with h | h | h | h | h | h
        · exact Or.inl (Or.inl h)
        all_goals exact Or.inr ⟨by omega,by omega⟩
  · exact absurd (by rw [lift']) ne

#print axioms setRV_post2U

section ts
variable {D : BitVec 64 → Prop} {B : Bool} {w : BitVec 64} {RR : ValueHOL 64 → Mem → GA → Prop}
  {SP0 P0 FM : BitVec 64} {G0 : GA} {J C SKB Bo U Sc : BitVec 64}

/-- The actual `htab_set(t, k, v)` on a `TabRV` table, exit layout located (`SetRV`). -/
theorem aqgd_call_htabSet_rv2U {LP : GA → Prop} (et ek ev : ExpHOL 64) (T Kk V Hl Hc Nj : BitVec 64) (l : TLay)
    (S : Set (BitVec 64)) (M1 : Mem) (G1 : GA)
    (hwP : w.toNat < P0.toNat) (hwT : ¬ TabPhys T l w) (rv : TabRV D B T l Hl S M1) (hH1 : HeapIs G1 Hc)
    (hN1 : G1.lookup (ofString "journal_n") = some (.val (.word Nj))) (hHl : Hl.toNat ≤ Hc.toNat)
    (Dall : ∀ a : BitVec 64, a.toNat < 33806089496 → D a)
    (sup : l.KL = 20 ∨ l.KL = 32 ∨ l.KL = 52) (sd : l.SD.toNat ≤ 56) (hV : V ∈ S)
    (hKE : Kk.toNat + 52 ≤ 33806089496)
    (hargs : ∀ {F : Type} (s : PanSemStateFiniteExact 64 F), s.memaddrs = D → s.memory = M1 → s.globals = G1 →
      LP s.locals → evalListHOLFinite s (h := fun a => Classical.propDecidable (s.memaddrs a)) [et,ek,ev] =
        some [.val (.word T),.val (.word Kk),.val (.word V)]) :
    AQGD D B (JWSBUS SP0 P0 FM G0 J C SKB Bo U Sc) w (fun _ => False)
      (fun L M G => LP L ∧ M = M1 ∧ G = G1)
      (fun L M G => (LP L ∧ ∃ Hp : BitVec 64, HeapIs G Hp ∧ Hc.toNat ≤ Hp.toNat ∧
        G.lookup (ofString "journal_n") = some (.val (.word Nj)) ∧
        ∀ x, ¬ TabPhys T l x → x.toNat < Hc.toNat → M x = M1 x) ∧ SetRV D B T l Hc S M G) RR
      (.call (some (none,none)) (ofString "htab_set") [et,ek,ev]) := by
  refine aqgd_addNormal (aqgd_call_htabSet_frame et ek ev T Kk V Hl Hc Nj l S M1 G1 hwP hwT rv hH1 hN1 hHl hargs) ?_
  intro F s code dom aw _ ⟨lp,hM,hG⟩ post run
  have hH : HeapIs s.globals Hc := by rw [hG]; exact hH1
  have hf := jws_heap_facts aw.1.1.1 hH
  exact setRV_post2U s post T Kk V Hc Hl l S et ek ev dom.2.1 dom.2.2 code Dall (by rw [hM]; exact rv) hH hHl hf.2.1
    hf.2.2 sup sd hV hKE (hargs (liftClock s (2 ^ 74)) dom.2.1 hM hG lp) run

#print axioms aqgd_call_htabSet_rv2U
end ts
end InitECandidate.Runtime
