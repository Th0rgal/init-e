import InitECandidate.Runtime.HeaderBytesChainWrittenContent
import InitECandidate.Runtime.DecodeHeaderEarlyBytesReach
import InitECandidate.Runtime.HeaderDecoderFragmentReach
/-!
The actual decode_header early-bytes chain produces the state root word.

The frozen body assigns and stores the first six header fields; the third one is the
32-byte state root, stored at the record offset 32.  Running the actual program from
`decodeHeaderAt 11` to `decodeHeaderAt 23` writes that offset exactly once, so the
finished chain holds the parsed word there.  The word is generated by the actual
composition (it is not assumed to be present beforehand), and the chain frame is
re-established against the entry state.
-/
namespace InitECandidate.Runtime
open Flapjack Flapjack.Pancake.PanLang Flapjack.PanSemStateFiniteExact
open Flapjack.Basis.Pure.MlString
set_option maxRecDepth 100000
set_option maxHeartbeats 800000

/-- The actual early bytes chain from `decodeHeaderAt 11` to `decodeHeaderAt 23`
generates the state root word at record offset 32 and leaves it readable there. -/
theorem decode_header_early_bytes_written_state_root {F : Type} (s : PanSemStateFiniteExact 64 F)
    (array count input inputLength scratch frame record : BitVec 64) (ceiling inputLimit : Nat)
    (countBound : 7 ≤ count.toNat)
    (atArray : s.locals.lookup (ofString "arr") = some (.val (.word array)))
    (atRecord : s.locals.lookup (ofString "h") = some (.val (.word record)))
    (before : array.toNat + count.toNat * 16 ≤ record.toNat)
    (recordFits : record.toNat + 248 < 2^64)
    (table : RlpSliceInputPrefix s array input inputLength count.toNat)
    (above : ceiling ≤ array.toNat)
    (fits : array.toNat + count.toNat * 16 ≤ 2^64)
    (inputBound : inputLength.toNat ≤ inputLimit) (limitBound : inputLimit + 9 < 2^64)
    (scratchGlobal : s.globals.lookup (ofString "scratch_ptr") = some (.val (.word scratch)))
    (frameGlobal : s.globals.lookup (ofString "frame_mem_ptr") = some (.val (.word frame)))
    (code : s.code = originalRuntimeCode) (orderedFrame : frame ≤ scratch) (framePositive : 0 < frame.toNat)
    (scratchBelow : scratch.toNat ≤ ceiling)
    (arena : ∀ address : BitVec 64, frame.toNat ≤ address.toNat → address.toNat < ceiling → s.memaddrs address)
    (budget : 6 * headerDecoderUnitCost inputLimit ≤ s.clock) :
    Reaches s (decodeHeaderAt 11)
      (fun ready => ready.memaddrs (record + 32#64) ∧
        ∃ word : BitVec 64, ready.memory (record + 32#64) = .word word ∧
        ready.memaddrs = s.memaddrs ∧ ready.code = s.code ∧
        (∀ name : MlS, name ≠ ofString "f" → ready.locals.lookup name = s.locals.lookup name) ∧
        (∀ global : MlS, ready.globals.lookup global = s.globals.lookup global) ∧
        (∀ address : BitVec 64, ceiling ≤ address.toNat → address.toNat < record.toNat →
          ready.memory address = s.memory address))
      (6 * headerDecoderUnitCost inputLimit) (decodeHeaderAt 23) := by
  have validSteps : ∀ item ∈ decodeHeaderEarlyBytes, item.1.toNat < count.toNat ∧ item.2.2 < 248 := by
    intro item member
    obtain ⟨index,width,offset⟩ := item
    have facts : index.toNat ≤ 6 ∧ offset < 248 := by
      simp only [decodeHeaderEarlyBytes,List.mem_cons,List.not_mem_nil,or_false] at member
      rcases member with ⟨rfl,rfl,rfl⟩ | ⟨rfl,rfl,rfl⟩ | ⟨rfl,rfl,rfl⟩ | ⟨rfl,rfl,rfl⟩ |
        ⟨rfl,rfl,rfl⟩ | ⟨rfl,rfl,rfl⟩ <;> decide
    obtain ⟨small,off⟩ := facts
    exact ⟨Nat.lt_of_le_of_lt small (Nat.lt_of_lt_of_le (by decide : 6 < 7) countBound),off⟩
  have once : (decodeHeaderEarlyBytes.filter (fun item => item.2.2 == 32)).length = 1 := by decide
  have targetBound : 32 < 248 := by decide
  have costLe : 6 * (headerRlpFieldCost inputLimit + 1) ≤ 6 * headerDecoderUnitCost inputLimit := by
    unfold headerDecoderUnitCost
    exact Nat.mul_le_mul_left 6 (by omega)
  have chainBudget : 6 * (headerRlpFieldCost inputLimit + 1) ≤ s.clock :=
    Nat.le_trans costLe budget
  have chain := header_bytes_chain_written_content s array count input inputLength scratch frame record ceiling
    inputLimit decodeHeaderEarlyBytes (decodeHeaderAt 23) 32 validSteps once targetBound atArray atRecord before
    recordFits table above fits inputBound limitBound scratchGlobal frameGlobal code orderedFrame framePositive
    scratchBelow arena chainBudget
  rw [source_decode_header_early_bytes]
  refine reaches_mono s _ (decodeHeaderAt 23) _ _ _ _ costLe ?_ chain
  intro post kept
  obtain ⟨word,readable,reachable,tablePost,localsPost,domainPost,codePost,globalsPost,memoryPost⟩ := kept
  exact ⟨reachable,word,readable,domainPost,codePost,localsPost,globalsPost,memoryPost⟩

#print axioms decode_header_early_bytes_written_state_root
end InitECandidate.Runtime
