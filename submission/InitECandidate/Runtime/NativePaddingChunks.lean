def padSlackOK {width : Nat} [NeZero width] (b : Nat)
    (line : LabSem.LabLineHOL width) : Bool :=
  match line with
  | .label _ _ _ => true
  | .asm _ bytes len => decide (len ≤ bytes.length + b)
  | .labAsm _ _ bytes len => decide (len ≤ bytes.length + b)

