import InitECandidate.Runtime.DecodeHeaderSuffixCarry
import InitECandidate.Runtime.DecodeHeaderWholeCarry
import InitECandidate.Runtime.ReachesReturnedContinuation
/-!
The returned header pointer, with the generated state root readable at `pointer + 32`.

The suffix phase `decodeHeaderAt 56` decides between the current and the legacy suffix by
comparing the local `is_current` with zero.  This module replays that decision *inside* the
`Reaches` proof: the case analysis is on the actual evaluation of the condition expression,
so no fact about the entry local is needed.  When the condition is a word, the two suffixes
of `DecodeHeaderSuffixCarry` apply; when it is not a word (or the expression does not
evaluate), the actual semantics of `.ite` yields `(some .error, state)` without changing
the state, which is exactly the abort alternative of `Reaches`.  The current suffix needs
entry `22`, so this phase is stated for headers with at least `23` fields — the current
headers, where `is_current` is one.

Composing it with `decode_header_whole_carry` runs the whole actual body from
`decodeHeaderAt 11`, and `source_decode_header_return` turns the final program into the
actual `return` of the record pointer, so the returned value is the record and the state
root word generated by the early bytes chain is readable at `pointer + 32`.
-/
namespace InitECandidate.Runtime
open Flapjack Flapjack.Pancake.PanLang Flapjack.PanSemStateFiniteExact
open Flapjack.Basis.Pure.MlString
set_option maxRecDepth 100000
set_option maxHeartbeats 800000

/-- The budget of the whole actual header body including the current/legacy suffix. -/
def headerWholeBodyCost (inputLimit : Nat) : Nat :=
  headerWholeFieldCost inputLimit +
    ((headerRlpFieldCost inputLimit + 1) +
      ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35)))

/-- When the suffix condition does not evaluate to a word, the actual `.ite` takes its
error alternative without changing the state, so the run aborts inside any budget. -/
theorem header_suffix_error_reaches {F : Type} (next : PanSemStateFiniteExact 64 F)
    (P : PanSemStateFiniteExact 64 F → Prop) (K : Nat)
    (erroring : evaluateHOLFiniteState next (decodeHeaderAt 56) = (some .error, next)) :
    Reaches next (decodeHeaderAt 56) P K (decodeHeaderAt 57) := by
  refine Or.inr ⟨.error,?_,?_,?_,?_,?_⟩
  · rw [erroring]
  · intro v h
    cases h
  · rw [erroring]
    simp
  · rw [erroring]
  · intro h same
    cases same

#print axioms header_suffix_error_reaches

/-- The actual suffix decision of `decodeHeaderAt 56`, replayed on the evaluation of its
condition, keeps the carry for headers with at least twenty-three fields. -/
theorem header_carry_suffix_by_evaluation {F : Type} (s next : PanSemStateFiniteExact 64 F)
    (array count input inputLength scratch frame record word : BitVec 64) (ceiling inputLimit : Nat)
    (env : HeaderCarryEnv s array count input inputLength scratch frame record ceiling inputLimit)
    (carry : HeaderSuffixCarry s next array count input inputLength record word)
    (countBound : 23 ≤ count.toNat)
    (clock : (headerRlpFieldCost inputLimit + 1) +
      ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35)) ≤ next.clock) :
    Reaches next (decodeHeaderAt 56)
      (fun post => HeaderSuffixCarry s post array count input inputLength record word)
      ((headerRlpFieldCost inputLimit + 1) +
        ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35))) (decodeHeaderAt 57) := by
  cases hcond :
    @evalHOLExact 64 F _ next.toExact (fun address => Classical.propDecidable (next.memaddrs address))
      decodeHeaderCurrentCondition with
  | none =>
    apply header_suffix_error_reaches next _ _
    rw [source_decode_header_current_suffix,evaluateHOLFiniteState_seq_line780,evaluateHOLFiniteState_ite,hcond]
  | some value =>
    cases value with
    | val lab =>
      cases lab with
      | word w =>
        by_cases zero : w = 0
        · have legacy := header_carry_legacy_suffix s next array count input inputLength scratch frame record word
              ceiling inputLimit env carry
          have selected : evaluateHOLFiniteState next
              (.ite decodeHeaderCurrentCondition decodeHeaderCurrentSuffix decodeHeaderLegacySuffix) =
              evaluateHOLFiniteState next decodeHeaderLegacySuffix := by
            rw [evaluateHOLFiniteState_ite,hcond]
            simp [zero]
          have same : evaluateHOLFiniteState next (decodeHeaderAt 56) =
              evaluateHOLFiniteState next (.seq decodeHeaderLegacySuffix (decodeHeaderAt 57)) := by
            rw [source_decode_header_current_suffix,evaluateHOLFiniteState_seq_line780,selected,
              ← evaluateHOLFiniteState_seq_line780]
          exact header_reaches_same_evaluation next _ _ (decodeHeaderAt 57) _ _ same
            (reaches_mono next _ _ _ _ 0 _ (by omega) (fun _ kept => kept) legacy)
        · have current := header_carry_current_suffix s next array count input inputLength scratch frame record word
              ceiling inputLimit env carry countBound clock
          have selected : evaluateHOLFiniteState next
              (.ite decodeHeaderCurrentCondition decodeHeaderCurrentSuffix decodeHeaderLegacySuffix) =
              evaluateHOLFiniteState next decodeHeaderCurrentSuffix := by
            rw [evaluateHOLFiniteState_ite,hcond]
            simp only
            rw [if_neg zero]
          have same : evaluateHOLFiniteState next (decodeHeaderAt 56) =
              evaluateHOLFiniteState next (.seq decodeHeaderCurrentSuffix (decodeHeaderAt 57)) := by
            rw [source_decode_header_current_suffix,evaluateHOLFiniteState_seq_line780,selected,
              ← evaluateHOLFiniteState_seq_line780]
          exact header_reaches_same_evaluation next _ _ (decodeHeaderAt 57) _ _ same current
    | rStruct fields =>
      apply header_suffix_error_reaches next _ _
      rw [source_decode_header_current_suffix,evaluateHOLFiniteState_seq_line780,evaluateHOLFiniteState_ite,hcond]
    | nStruct name fields =>
      apply header_suffix_error_reaches next _ _
      rw [source_decode_header_current_suffix,evaluateHOLFiniteState_seq_line780,evaluateHOLFiniteState_ite,hcond]

#print axioms header_carry_suffix_by_evaluation

/-- The whole actual header body, from `decodeHeaderAt 11` to the body's return at
`decodeHeaderAt 57`, kept the carry at the returned point. -/
theorem decode_header_whole_body {F : Type} (s : PanSemStateFiniteExact 64 F)
    (array count input inputLength scratch frame record : BitVec 64) (ceiling inputLimit : Nat)
    (env : HeaderCarryEnv s array count input inputLength scratch frame record ceiling inputLimit)
    (atArray : s.locals.lookup (ofString "arr") = some (.val (.word array)))
    (atRecord : s.locals.lookup (ofString "h") = some (.val (.word record)))
    (table : RlpSliceInputPrefix s array input inputLength count.toNat)
    (countBound : 23 ≤ count.toNat)
    (budget : headerWholeBodyCost inputLimit ≤ s.clock) :
    Reaches s (decodeHeaderAt 11)
      (fun post => ∃ word : BitVec 64, HeaderSuffixCarry s post array count input inputLength record word)
      (headerWholeBodyCost inputLimit) (decodeHeaderAt 57) := by
  unfold headerWholeBodyCost at budget
  apply reaches_trans_budget s (decodeHeaderAt 11) (decodeHeaderAt 56) (decodeHeaderAt 57) _ _
    (headerWholeFieldCost inputLimit)
    ((headerRlpFieldCost inputLimit + 1) +
      ((headerRlpFieldCost inputLimit + 1) + (headerRlpFieldCost inputLimit + 35))) (by omega)
    (decode_header_whole_carry s array count input inputLength scratch frame record ceiling inputLimit env atArray
      atRecord table (by omega))
  intro next carried remaining
  obtain ⟨word,kept⟩ := carried
  refine reaches_mono next (decodeHeaderAt 56) (decodeHeaderAt 57) _ _ _ _ (le_refl _) ?_
    (header_carry_suffix_by_evaluation s next array count input inputLength scratch frame record word ceiling
      inputLimit env kept countBound (by omega))
  intro post final
  exact ⟨word,final⟩

#print axioms decode_header_whole_body

/-- A returned execution of the whole actual header body returns its allocated record as
the header pointer and leaves the generated state root word readable at `pointer + 32`,
together with the record's domain, the code, the globals and the record geometry. -/
theorem decode_header_whole_returned_root {F : Type} (s post : PanSemStateFiniteExact 64 F)
    (array count input inputLength scratch frame record : BitVec 64) (ceiling inputLimit : Nat)
    (env : HeaderCarryEnv s array count input inputLength scratch frame record ceiling inputLimit)
    (atArray : s.locals.lookup (ofString "arr") = some (.val (.word array)))
    (atRecord : s.locals.lookup (ofString "h") = some (.val (.word record)))
    (table : RlpSliceInputPrefix s array input inputLength count.toNat)
    (countBound : 23 ≤ count.toNat)
    (budget : headerWholeBodyCost inputLimit ≤ s.clock) (value : ValueHOL 64)
    (run : evaluateHOLFiniteState s (decodeHeaderAt 11) = (some (.returned value),post)) :
    value = .val (.word record) ∧
      (∃ word : BitVec 64, post.memory (record + 32#64) = .word word) ∧
      post.memaddrs = s.memaddrs ∧ post.code = s.code ∧
      (∀ global : MlS, post.globals.lookup global = s.globals.lookup global) ∧
      array.toNat + count.toNat * 16 ≤ record.toNat ∧ record.toNat + 248 < 2^64 := by
  have reached := decode_header_whole_body s array count input inputLength scratch frame record ceiling inputLimit env
    atArray atRecord table countBound budget
  obtain ⟨ready,carried,_,_,agreement,returnedTail⟩ := reaches_returned_continuation s (decodeHeaderAt 11)
    (decodeHeaderAt 57) _ (headerWholeBodyCost inputLimit) value reached (by rw [run])
  have tailMemory : (evaluateHOLFiniteState ready (decodeHeaderAt 57)).2.memory = ready.memory := by
    rw [source_decode_header_return,evaluateHOLFiniteState_return]
    repeat first | split | rfl
  have tailGlobals : (evaluateHOLFiniteState ready (decodeHeaderAt 57)).2.globals = ready.globals := by
    rw [source_decode_header_return,evaluateHOLFiniteState_return]
    repeat first | split | rfl
  have sourceMemory := agreement.2.2.1
  have sourceGlobals := agreement.2.2.2.1
  rw [run] at sourceMemory sourceGlobals
  have metadata := evaluateHOLFiniteState_metadata s (decodeHeaderAt 11)
  rw [run] at metadata
  obtain ⟨word,rootMem,domain,code,globals,_,atRecordReady⟩ := carried
  refine ⟨?_,⟨word,?_⟩,metadata.2.1,metadata.1,?_,env.before,env.recordFits⟩
  · rw [source_decode_header_return,evaluateHOLFiniteState_return] at returnedTail
    simpa [evalHOLExact,atRecordReady,shapeOfHOLExact] using returnedTail.symm
  · rw [sourceMemory,tailMemory]
    exact rootMem
  · intro global
    rw [sourceGlobals,tailGlobals]
    exact globals global

#print axioms decode_header_whole_returned_root
end InitECandidate.Runtime
