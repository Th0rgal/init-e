def sszInitAllocations : List (MlS × BitVec 64) :=
  [(ofString "ssz_len_chunk",32),(ofString "ssz_offs",64),(ofString "zero_hashes",2048)]

def sszInitTable : ProgHOL 64 :=
  globalConstantStores (ofString "zero_hashes") sszInitCells (.return (.const 0))

def sszInitActualSetup : ProgHOL 64 :=
  globalAllocationProgram [(ofString "ssz_len_chunk",32),(ofString "ssz_offs",64)]
    (.seq (.call (some (some (.global,ofString "zero_hashes"),none)) (ofString "alloc")
      [.panop .mul [.const 64,.const 32]]) sszInitTable)

def sszInitNormalizedSetup : ProgHOL 64 :=
  globalAllocationProgram sszInitAllocations sszInitTable

theorem source_sszInit_body : sourceFunctionBody Guest.guestFn_ssz_init =
    .seq (.ite (.cmp .notEqual (.var .global (ofString "zero_hashes")) (.const 0))
      (.return (.const 0)) .skip) sszInitActualSetup := by
  unfold sourceFunctionBody
  rw [InitECandidate.Proofs.FrontendCodecComputation.declToHOL_eq]
  rfl

#print axioms source_sszInit_body
