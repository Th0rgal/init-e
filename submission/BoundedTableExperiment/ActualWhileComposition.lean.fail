import InitECandidate.Runtime.PanStatementWork

set_option maxHeartbeats 1000000
set_option maxRecDepth 100000

namespace BoundedTableExperiment

open InitECandidate.Runtime
open InitECandidate.Runtime.FineCost
open Flapjack
open Flapjack.Pancake.PanLang
open Flapjack.PanSemStateFiniteExact

/-- Actual finite `while` execution certificate, indexed by the **outer** while
result. `break` and `continue` body results are consumed by the loop and do
not escape. -/
inductive WhileEvents {F : Type} (fn : MlS) (condition : ExpHOL 64)
    (body : ProgHOL 64) :
    PanSemStateFiniteExact 64 F → Option (PanSemResultExact 64) →
    PanSemStateFiniteExact 64 F → List WorkEvent → Prop
  | stop {s} {guardEvents : List WorkEvent}
      (guard : CostedExpressionRun s condition (some (.val (.word 0))) guardEvents) :
      WhileEvents fn condition body s none s
        (.statement :: .cost (whileOverhead + loopMoves fn) :: guardEvents)
  | next {s middle post} {value : BitVec 64} {r : Option (PanSemResultExact 64)}
      {guardEvents bodyEvents restEvents : List WorkEvent}
      (guard : CostedExpressionRun s condition (some (.val (.word value))) guardEvents)
      (nonzero : value ≠ 0)
      (one : StatementRun fn (decClockHOLFinite s) body none middle bodyEvents)
      (rest : WhileEvents fn condition body middle r post restEvents) :
      WhileEvents fn condition body s r post
        (.statement :: .cost (whileOverhead + loopMoves fn) ::
          (guardEvents ++ bodyEvents ++ restEvents))
  | break {s post} {value : BitVec 64}
      {guardEvents bodyEvents : List WorkEvent}
      (guard : CostedExpressionRun s condition (some (.val (.word value))) guardEvents)
      (nonzero : value ≠ 0)
      (one : StatementRun fn (decClockHOLFinite s) body (some .break) post bodyEvents) :
      WhileEvents fn condition body s none post
        (.statement :: .cost (whileOverhead + loopMoves fn) ::
          (guardEvents ++ bodyEvents))
  | continue {s middle post} {value : BitVec 64} {r : Option (PanSemResultExact 64)}
      {guardEvents bodyEvents restEvents : List WorkEvent}
      (guard : CostedExpressionRun s condition (some (.val (.word value))) guardEvents)
      (nonzero : value ≠ 0)
      (one : StatementRun fn (decClockHOLFinite s) body (some .continue) middle bodyEvents)
      (rest : WhileEvents fn condition body middle r post restEvents) :
      WhileEvents fn condition body s r post
        (.statement :: .cost (whileOverhead + loopMoves fn) ::
          (guardEvents ++ bodyEvents ++ restEvents))
  | timeout {s} {value : BitVec 64} {guardEvents : List WorkEvent}
      (guard : CostedExpressionRun s condition (some (.val (.word value))) guardEvents)
      (nonzero : value ≠ 0) (clock : s.clock = 0) :
      WhileEvents fn condition body s (some .timeOut) (emptyLocalsHOLFinite s)
        (.statement :: .cost (whileOverhead + loopMoves fn) :: guardEvents)
  | missingGuard {s} {guardEvents : List WorkEvent}
      (guard : CostedExpressionRun s condition none guardEvents) :
      WhileEvents fn condition body s (some .error) s
        (.statement :: guardEvents)
  | invalidGuard {s} {value : Option (ValueHOL 64)}
      {guardEvents : List WorkEvent}
      (guard : CostedExpressionRun s condition value guardEvents)
      (notWord : ∀ word : Word,
        value ≠ some (.val (.word word))) :
      WhileEvents fn condition body s (some .error) s
        (.statement :: guardEvents)
  | propagate {s post} {value : BitVec 64}
      {guardEvents bodyEvents : List WorkEvent} {result : PanSemResultExact 64}
      (guard : CostedExpressionRun s condition (some (.val (.word value))) guardEvents)
      (nonzero : value ≠ 0) (clock : s.clock ≠ 0)
      (notBreak : result ≠ .break) (notContinue : result ≠ .continue)
      (one : StatementRun fn (decClockHOLFinite s) body (some result) post bodyEvents) :
      WhileEvents fn condition body s (some result) post
        (.statement :: .cost (whileOverhead + loopMoves fn) ::
          (guardEvents ++ bodyEvents))

/-- Bundled actual while run for well-founded extraction. -/
structure WhileData {F : Type} (fn : MlS) (condition : ExpHOL 64)
    (body : ProgHOL 64) where
  s : PanSemStateFiniteExact 64 F
  r : Option (PanSemResultExact 64)
  post : PanSemStateFiniteExact 64 F
  events : List WorkEvent
  run : StatementRun fn s (.while condition body) r post events

/-- Extract the actual finite iteration certificate from an actual `while` run.
The result index is general; recursive iterations decrease the clock. -/
def whileEventsOfRun {F : Type} {fn : MlS} {condition : ExpHOL 64}
    {body : ProgHOL 64} (d : @WhileData F fn condition body) :
    @WhileEvents F fn condition body d.s d.r d.post d.events :=
  WellFounded.fix
    (C := fun d : @WhileData F fn condition body =>
      @WhileEvents F fn condition body d.s d.r d.post d.events)
    (measure fun d : @WhileData F fn condition body => d.s.clock).wf
    (fun d rec => by
      rcases d with ⟨s, r, post, events, run⟩
      cases run with
      | whileFalse guard =>
          change WhileEvents fn condition body s none s _
          exact WhileEvents.stop guard
      | whileNext guard nonzero clock one rest =>
          change WhileEvents fn condition body s r post _
          exact WhileEvents.next guard nonzero one
            (rec ⟨_, _, _, _, rest⟩ (by
              change (measure fun d : @WhileData F fn condition body => d.s.clock).rel _ _
              simp [WellFoundedRelation.rel, measure, decClockHOLFinite]
              trace_state
              omega))
      | whileBreak guard nonzero clock one =>
          change WhileEvents fn condition body s none post _
          exact WhileEvents.break guard nonzero one
      | whileContinue guard nonzero clock one rest =>
          change WhileEvents fn condition body s r post _
          exact WhileEvents.continue guard nonzero one
            (rec ⟨_, _, _, _, rest⟩ (by
              change (measure fun d : @WhileData F fn condition body => d.s.clock).rel _ _
              simp [WellFoundedRelation.rel, measure, decClockHOLFinite]
              trace_state
              omega))
      | whileTimeout guard nonzero clock =>
          change WhileEvents fn condition body s (some .timeOut) (emptyLocalsHOLFinite s) _
          exact WhileEvents.timeout guard nonzero clock
      | whileInvalidGuard guard notWord =>
          change WhileEvents fn condition body s (some .error) s _
          exact WhileEvents.invalidGuard guard notWord
      | whileMissingGuard guard =>
          change WhileEvents fn condition body s (some .error) s _
          exact WhileEvents.missingGuard guard
      | whilePropagate guard nonzero clock notBreak notContinue one =>
          change WhileEvents fn condition body s (some _) post _
          exact WhileEvents.propagate guard nonzero clock notBreak notContinue one)
    d

/-- Successful-result wrapper. -/
def whileEventsSuccess {F : Type} {fn : MlS} {condition : ExpHOL 64}
    {body : ProgHOL 64} {s post : PanSemStateFiniteExact 64 F}
    {events : List WorkEvent}
    (run : StatementRun fn s (.while condition body) none post events) :
    WhileEvents fn condition body s none post events :=
  whileEventsOfRun ⟨s, none, post, events, run⟩

end BoundedTableExperiment

#print axioms BoundedTableExperiment.whileEventsOfRun
