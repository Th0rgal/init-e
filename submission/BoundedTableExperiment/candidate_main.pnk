#include "config.h"
#include "types.h"
#include "lib/mem.pnk"
#include "submission/BoundedTableExperiment/htab_patricia.pnk"

fun 1 ps_key(1 buf, 1 i) {
  memzero(buf, 20);
  st buf, i;
  st buf + 8, i * 3;
  return 0;
}

fun 1 main() {
  mem_init();
  var 1 t = htab_new(20, 8);
  var 1 buf = alloc(20);
  var i = 0;
  while i < 8 {
    ps_key(buf, i);
    htab_set(t, buf, i);
    i = i + 1;
  }
  i = 0;
  var sum = 0;
  while i < 8 {
    ps_key(buf, i);
    var {1,1} g = htab_get(t, buf);
    if g.0 != 0 { sum = sum + g.1; }
    i = i + 1;
  }
  st 2688614400, sum;
  return sum;
}
